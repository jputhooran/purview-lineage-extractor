{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lineage-utility:graph:1.0",
  "title": "Canonical Lineage Graph v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "assets",
    "processes",
    "field_mappings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qualified_name", "kind", "attributes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "qualified_name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "attributes": {"type": "object"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/process"}
    },
    "field_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldMapping"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "data_type": {"type": "string"},
        "attributes": {"type": "object"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_name",
        "name",
        "asset_type",
        "fields",
        "attributes"
      ],
      "properties": {
        "qualified_name": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "asset_type": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/field"}
        },
        "attributes": {"type": "object"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_name",
        "name",
        "process_type",
        "inputs",
        "outputs",
        "attributes",
        "legacy_qualified_names"
      ],
      "properties": {
        "qualified_name": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "process_type": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "attributes": {"type": "object"},
        "legacy_qualified_names": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_reference": {"type": "string", "minLength": 1}
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_qualified_name",
        "source_asset_qualified_name",
        "source_field",
        "target_asset_qualified_name",
        "target_field",
        "transform"
      ],
      "properties": {
        "process_qualified_name": {"type": "string", "minLength": 1},
        "source_asset_qualified_name": {"type": "string", "minLength": 1},
        "source_field": {"type": "string", "minLength": 1},
        "target_asset_qualified_name": {"type": "string", "minLength": 1},
        "target_field": {"type": "string", "minLength": 1},
        "transform": {"type": "string", "minLength": 1}
      }
    }
  }
}
