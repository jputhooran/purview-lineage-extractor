{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lineage-utility:config:1",
  "title": "Lineage Utility Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobs"],
  "properties": {
    "version": {"const": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_dir": {"type": "string", "minLength": 1},
        "state_file": {"type": "string", "minLength": 1},
        "manifest_dir": {"type": "string", "minLength": 1}
      }
    },
    "publishers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["plugin"],
        "properties": {
          "plugin": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "extractor", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "extractor": {"type": "string", "minLength": 1},
          "source": {"type": "object"},
          "publishers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "enabled": {"type": "boolean"},
          "continue_on_error": {"type": "boolean"},
          "output_dir": {"type": "string", "minLength": 1},
          "emit_legacy_model": {"type": "boolean"}
        }
      }
    }
  }
}
